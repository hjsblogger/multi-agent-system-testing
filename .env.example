# Google Gemini API key from Google AI Studio
GEMINI_API_KEY=

# Recommended free-tier model for this POC.
# You can change this if your key has access to another Gemini model.
GEMINI_MODEL=gemini-3.5-flash-lite

# API key protecting your own /chat endpoint.
# This is separate from the Gemini key.
AGENT_API_KEY=

# Maximum number of Coder -> Verifier retries after a verification failure.
MAX_VERIFIER_RETRIES=1
